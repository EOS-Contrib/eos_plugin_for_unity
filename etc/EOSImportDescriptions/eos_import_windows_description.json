{
    "source_to_dest": [
        {"src":"SDK/Source/Generated/Windows/*.cs", "dest": "com.playeveryware.eos/Runtime/EOS_SDK/Generated/Windows/"},
        {"src":"SDK/Source/Generated/Windows/Platform/*.cs", "dest": "com.playeveryware.eos/Runtime/EOS_SDK/Generated/Windows/Platform/"},
        {"src":"SDK/Source/Generated/Windows/IntegratedPlatform/*.cs", "dest": "com.playeveryware.eos/Runtime/EOS_SDK/Generated/Windows/IntegratedPlatform/"},

        {"src": "SDK/Bin/EOSSDK-Win64-Shipping.dll", "dest": "Assets/Plugins/Windows/x64/"},
        {"src": "SDK/Bin/EOSSDK-Win64-Shippingarm64.dll", "dest": "Assets/Plugins/Windows/x64/"},
        {"src": "SDK/Bin/x64/", "pattern": "*.dll", "dest": "Assets/Plugins/Windows/x64/"},

        {"src": "SDK/Include/Windows/*.h", "dest": "lib/NativeCode/third_party/eos_sdk/include/Windows/"},

        {"src": "SDK/Tools/EOSBootstrapper.exe", "dest": "tools/bin/"},
        {"src": "SDK/Tools/EOSBootstrapperTool.exe", "dest": "tools/bin/"}
    ]
}
